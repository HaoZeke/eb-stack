builddependencies = [
    ('binutils', '2.45'),
    ('Rust', '1.94.1'),
    ('Meson', '1.10.2'),
    ('Ninja', '1.13.2'),
    ('pkgconf', '2.5.1'),
    ('Python', '3.14.2'),
    ('CMake', '4.2.1'),
    ('LLVM', '21.1.8'),
]

# Explicit features match meson_options.txt default; do not drop highs.
configopts = "-Dwith_tests=true -Drgmin_features=capi,highs"

start_dir = f'{name}-{local_commit}'

runtest = 'meson'
testopts = 'test -C %(builddir)s/easybuild_obj --print-errorlogs'

sanity_check_paths = {
    'files': [
        'include/rgmin.h',
        'include/rgmin.hpp',
        'lib/librgmin.a',
        f'lib/librgmin.{SHLIB_EXT}',
        'lib/pkgconfig/rgmin.pc',
    ],
    'dirs': [],
}

sanity_check_commands = [
    'pkg-config --exact-version=%(version)s rgmin',
]

moduleclass = 'lib'
