easyblock = 'CargoMesonNinja'

name = 'rgmin'
version = '0.5.2'
local_commit = '18959f8acfbb9afb53586b5010dbdcb56b7f0f1a'
versionsuffix = f'-git{local_commit[:8]}'

homepage = 'https://github.com/OmniPotentRPC/rgmin'
description = """Local first-order minimization over eindir differentiable objectives,
with a C/C++ interface (librgmin, rgmin.h, rgmin.pc). Meson default features are
capi,highs so the HiGHS box/trust setters eOn consumes stay enabled. Cargo.lock
pins highs-sys 1.15.0, which builds its vendored HiGHS 1.15.0 via CMake."""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

github_account = 'OmniPotentRPC'
source_urls = ['https://github.com/OmniPotentRPC/rgmin/archive/']
