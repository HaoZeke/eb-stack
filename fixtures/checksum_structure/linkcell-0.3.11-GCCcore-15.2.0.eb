easyblock = 'CargoMesonNinja'

name = 'linkcell'
version = '0.3.11'

homepage = 'https://github.com/d-SEAMS/linkcell'
description = """linkcell builds cell lists and neighbour lists for periodic and open
 boxes in Rust, with a C/C++ interface (liblinkcell, linkcell.h, linkcell.hpp, linkcell.pc).
 eOn uses it for neighbour searches."""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

github_account = 'd-SEAMS'
source_urls = [GITHUB_SOURCE]
sources = [{
    'download_filename': 'v%(version)s.tar.gz',
    'filename': SOURCE_TAR_GZ,
}]
crates = [
    ('autocfg', '1.5.1'),
    ('cc', '1.4.3'),
    ('crossbeam-deque', '0.8.7'),
    ('crossbeam-epoch', '0.9.20'),
    ('crossbeam-utils', '0.8.22'),
    ('dlpk', '0.4.1'),
    ('either', '1.17.0'),
    ('find-msvc-tools', '0.1.11'),
    ('heck', '0.5.0'),
    ('libc', '0.2.189'),
    ('matrixmultiply', '0.3.11'),
    ('minimage', '0.1.4'),
    ('ndarray', '0.17.2'),
    ('num-complex', '0.4.6'),
    ('num-integer', '0.1.47'),
    ('num-traits', '0.2.19'),
    ('once_cell', '1.21.4'),
    ('portable-atomic', '1.15.0'),
    ('portable-atomic-util', '0.2.7'),
    ('proc-macro2', '1.0.107'),
    ('pyo3', '0.29.2'),
