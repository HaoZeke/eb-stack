builddependencies = [
    ('binutils', '2.45'),
    ('Rust', '1.94.1'),
    ('Meson', '1.10.2'),
    ('Ninja', '1.13.2'),
    ('pkgconf', '2.5.1'),
    ('Python', '3.14.2'),
]

# The Meson build drives cargo with the crate's default features (capi, parallel) on
# the vendored crates above and installs the shared and static library, both headers
# and linkcell.pc. with_gpulite keeps its auto default; gpulite is not a dependency,
# so linkcell-gpu is not built.
configopts = '-Dwith_tests=true -Dwith_examples=true'

runtest = 'meson'
testopts = 'test -C %(builddir)s/easybuild_obj --print-errorlogs'

sanity_check_paths = {
    'files': [
        'include/linkcell.h',
        'include/linkcell.hpp',
        'lib/liblinkcell.a',
        'lib/liblinkcell.%s' % SHLIB_EXT,
        'lib/pkgconfig/linkcell.pc',
    ],
    'dirs': [],
}

sanity_check_commands = [
    'pkg-config --exact-version=%(version)s linkcell',
]

moduleclass = 'lib'
